# Skopiuj: cp .env.example .env
# Lokalnie (Gradle / docker-compose.dev): zostaw APP_ENV=dev i API_ENV=dev.
# Produkcja (VPS): CI generuje .env z sekretów; APP_ENV/API_ENV=prod.

TZ=Europe/Warsaw

# --- Tryb aplikacji ---
# dev  = sandbox P24 (domyślnie), mocki bramy/płatności gdy brak credentials
# prod = wymaga pełnych sekretów; P24 production; GATE_MOCK/PAYMENT_MOCK=false
APP_ENV=dev
API_ENV=dev
EMAIL_ENV=dev

# --- Baza (Gradle lokalnie: localhost; Docker DEV: przyczepki_db w compose) ---
# Prod: port 27017 tylko na 127.0.0.1 VPS. Dostęp z lokalnej maszyny:
#   ssh -L 27017:127.0.0.1:27017 user@vps
# potem mongodb://USER:PASS@localhost:27017/przyczepki?authSource=admin
DB_HOST=localhost
DB_PORT=27017
DB_NAME=przyczepki
DB_USER=dev
DB_PASSWORD=dev
DB_AUTH_SOURCE=admin

# --- Auth JWT ---
AUTH_SECRET_LOGIN=dev-auth-secret
AUTH_SECRET_REFRESH=dev-refresh-secret
AUTH_ISSUER=ktor-dev
AUTH_AUDIENCE=ktor-dev
AUTH_REALM=ktor-dev
AUTH_ACCESS_TOKEN_EXPIRY=3600000
AUTH_REFRESH_TOKEN_EXPIRY=2592000000
AUTH_CLAIM=userId
INTERNAL_API_KEY=dev-internal-api-key

# --- Hosty / porty ---
# Gradle: web 8080 (webpack), API 8090
# Docker DEV: web 80, API 8090
WEB_HOST=localhost
WEB_PORT=80
API_HOST=localhost
API_PORT=8090
EMAIL_HOST=localhost
EMAIL_PORT=8200

# --- Email (Gmail OAuth) — opcjonalne lokalnie ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
BCC=

# --- Płatności Przelewy24 ---
# Lokalnie: PAYMENT_MOCK=true (bez realnych transakcji)
# Prod: PAYMENT_ENV=production, PAYMENT_MOCK=false + prawdziwe credentials
PAYMENT_ENV=sandbox
PAYMENT_MOCK=true
PAYMENT_MERCHANT_ID=0
PAYMENT_POS_ID=0
PAYMENT_SECRET_ID=dev-secret
PAYMENT_CRC=dev-crc
# Gradle (web na 8080):
PAYMENT_URL_RETURN=http://localhost:8080/podsumowanieRezerwacji
PAYMENT_URL_STATUS=http://localhost:8090/payment/notification
# Docker DEV (web na 80) — odkomentuj zamiast powyższych:
# PAYMENT_URL_RETURN=http://localhost:80/podsumowanieRezerwacji

# --- Brama / Supla ---
# Lokalnie: GATE_MOCK=true (bez realnego otwierania)
GATE_OPEN_URL=
GATE_OPEN_METHOD=PATCH
GATE_ACCESS_TOKEN=
GATE_API_KEY=
GATE_REQUEST_BODY={"action":"OPEN_CLOSE"}
GATE_MOCK=true
GATE_COOLDOWN_SECONDS=60
SUPLA_ID=
SUPLA_SECRET=
SUPLA_TOKEN_URL=https://svr111.supla.org/oauth/v2/token
SUPLA_REDIRECT_URI=
SUPLA_REFRESH_TOKEN=
SUPLA_OAUTH_HELPER=true
